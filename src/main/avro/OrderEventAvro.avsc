{
  "type": "record",
  "name": "OrderEventAvro",
  "namespace": "com.learning.kafka.dto",
  "doc": "Avro counterpart to OrderEvent (the hand-written JSON POJO). Registered with Schema Registry under subject cloud-avro-orders-topic-value; compatibility mode is BACKWARD.",
  "fields": [
    { "name": "orderId", "type": "string" },
    { "name": "amount", "type": "double" },
    { "name": "timestamp", "type": "long" },
    { "name": "customerId", "type": "string", "default": "default-customer" }
  ]
}